    {
      "id": "u01-l1",
      "title": "Saying hello",
      "goal": "Greet anyone at any time of day and say goodbye.",
      "tip": {
        "title": "Bonjour all day, bonsoir in the evening",
        "body": "Bonjour works from morning until late afternoon; switch to Bonsoir in the evening. Salut is a casual hi or bye for friends. Always say bonjour when you walk into a shop or a lift — skipping it feels rude. Pronunciation: the on in bonjour is a nasal vowel — don't say the n, let the air go through your nose. In au revoir the r is soft, made at the back of the throat."
      },
      "phrases": [
        {
          "t": "Bonjour !",
          "n": "Hello! / Good morning!",
          "note": "Polite and neutral, used all day."
        },
        {
          "t": "Bonsoir !",
          "n": "Good evening!"
        },
        {
          "t": "Salut !",
          "n": "Hi! / Bye!",
          "note": "Informal, for friends. The t is silent."
        },
        {
          "t": "Coucou !",
          "n": "Hiya!",
          "note": "Very casual, for close friends and family."
        },
        {
          "t": "Au revoir !",
          "n": "Goodbye!"
        },
        {
          "t": "Bonne nuit !",
          "n": "Good night!",
          "note": "Only when someone is going to bed."
        },
        {
          "t": "À plus tard !",
          "n": "See you later!"
        },
        {
          "t": "À bientôt !",
          "n": "See you soon!"
        }
      ],
