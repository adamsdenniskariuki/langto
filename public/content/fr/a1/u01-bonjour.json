    {
      "id": "u01-l2",
      "title": "How are you?",
      "goal": "Ask how someone is and answer.",
      "tip": {
        "title": "tu or vous?",
        "body": "French has two words for \"you\": tu for friends, family, children and pets; vous for strangers, older people, shop staff and colleagues you don't know well (vous is also the plural \"you\"). When in doubt, use vous and wait for the other person to suggest tu. Ça va ? is casual; Comment allez-vous ? is polite. Ça va ? needs only a rising voice to become a question."
      },
      "phrases": [
        {
          "t": "Ça va ?",
          "n": "How's it going?",
          "note": "Informal; the answer can be just Ça va !"
        },
        {
          "t": "Comment allez-vous ?",
          "n": "How are you? (formal)",
          "note": "Liaison: the t of comment links to allez — \"ko-mahn-ta-lay-voo\"."
        },
        {
          "t": "Comment vas-tu ?",
          "n": "How are you? (informal)"
        },
        {
          "t": "Ça va bien, merci.",
          "n": "I'm fine, thanks."
        },
        {
          "t": "Très bien !",
          "n": "Very well!"
        },
        {
          "t": "Pas mal.",
          "n": "Not bad."
        },
        {
          "t": "Bof, comme ci, comme ça.",
          "n": "Meh, so-so."
        },
        {
          "t": "Et toi ?",
          "n": "And you? (informal)"
        },
        {
          "t": "Et vous ?",
          "n": "And you? (formal)"
        }
