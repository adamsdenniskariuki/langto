    {
      "id": "u01-l4",
      "kind": "grammar",
      "title": "tu or vous: s'appeler",
      "goal": "Ask and give names with tu and vous correctly.",
      "tip": {
        "title": "Literally: \"I call myself\"",
        "body": "French says je m'appelle (\"I call myself\"), tu t'appelles, il/elle s'appelle, vous vous appelez. The little word me/te/se shortens to m'/t'/s' before a vowel (élision). With tu the verb ends in -es (silent); with vous it ends in -ez (sounds like \"ay\"). You can ask a question three ways: Comment tu t'appelles ? (casual), Tu t'appelles comment ? (very casual) or Comment vous appelez-vous ? (polite, with the verb first)."
      },
      "phrases": [
        {
          "t": "Comment tu t'appelles ?",
          "n": "What's your name? (informal)"
        },
        {
          "t": "Comment vous appelez-vous ?",
          "n": "What's your name? (formal)"
        },
        {
          "t": "Je m'appelle Tom.",
          "n": "My name is Tom."
        },
        {
          "t": "Il s'appelle Marc.",
          "n": "His name is Marc."
        },
        {
          "t": "Elle s'appelle Julie.",
          "n": "Her name is Julie."
        }
      ],
      "drills": [
