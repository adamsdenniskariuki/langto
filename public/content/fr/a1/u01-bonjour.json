    {
      "id": "u01-l3",
      "title": "Please & thank you",
      "goal": "Be polite in any situation.",
      "tip": {
        "title": "Two ways to say please",
        "body": "S'il vous plaît (vous) and s'il te plaît (tu) both mean \"please\" — literally \"if it pleases you\". Answer merci with de rien (casual) or je vous en prie (polite). Pardon is for bumping into someone or squeezing past; excusez-moi is for getting someone's attention. Pronunciation: in merci the r is in the throat and the e sounds like the e in \"bed\"."
      },
      "phrases": [
        {
          "t": "Merci !",
          "n": "Thanks!"
        },
        {
          "t": "Merci beaucoup !",
          "n": "Thank you very much!"
        },
        {
          "t": "S'il vous plaît.",
          "n": "Please. (formal)"
        },
        {
          "t": "S'il te plaît.",
          "n": "Please. (informal)"
        },
        {
          "t": "De rien !",
          "n": "You're welcome!"
        },
        {
          "t": "Je vous en prie.",
          "n": "You're welcome. (polite)",
          "note": "Also means \"go ahead\" when you hold a door."
        },
        {
          "t": "Pardon !",
          "n": "Sorry! / Excuse me!"
        },
        {
          "t": "Excusez-moi.",
          "n": "Excuse me."
        }
      ],
