  "lessons": [
    {
      "id": "pron-u03-l1",
      "kind": "pron",
      "title": "The French r",
      "goal": "Make the r in the throat, not with the lips or tongue tip.",
      "tip": {
        "title": "A soft gargle",
        "body": "The French r is made at the back of the mouth: the back of the tongue comes close to the uvula, like a soft, voiced version of the \"ch\" in Scottish \"loch\" — or a very light gargle. Keep the tip of your tongue resting behind your lower teeth and don't round your lips. Practise by saying \"aga\" and relaxing the g until air rubs through. Don't drop a final r: mer and pour need it."
      },
      "phrases": [
        {
          "t": "Merci beaucoup !",
          "n": "Thank you very much!"
        },
        {
          "t": "Au revoir !",
          "n": "Goodbye!"
        },
        {
          "t": "J'habite à Paris.",
          "n": "I live in Paris.",
          "note": "The final s is silent: \"Pa-ri\"."
        },
        {
          "t": "Bonsoir !",
          "n": "Good evening!"
        }
      ],
