    {
      "id": "pron-u03-l2",
      "kind": "pron",
      "title": "r and l, r in clusters",
      "goal": "Tell r from l and say tr, cr, pr smoothly.",
      "tip": {
        "title": "No vowel inside tr, cr, pr",
        "body": "In clusters like tr, pr, cr, gr, fr the r follows the first consonant straight away — don't slip in an extra vowel (\"te-rois\") and don't use an English r. trois must stay different from toi, and crois from quoi. Keep r and l apart: l is made with the tongue tip behind the upper teeth; r is made at the back with the tongue tip down."
      },
      "phrases": [
        {
          "t": "Trois croissants, s'il vous plaît.",
          "n": "Three croissants, please."
        },
        {
          "t": "C'est très grand.",
          "n": "It's very big."
        },
        {
          "t": "Je préfère le rouge.",
          "n": "I prefer the red one."
        },
        {
          "t": "Il fait froid.",
          "n": "It's cold."
        }
      ],
