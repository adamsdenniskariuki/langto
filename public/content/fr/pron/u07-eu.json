  "title": "Les sons eu",
  "subtitle": "deux, peur — and eu vs ou",
  "icon": "😮",
  "lessons": [
    {
      "id": "pron-u07-l1",
      "kind": "pron",
      "title": "Closed and open eu",
      "goal": "Say deux and peur, and keep eu apart from é and è.",
      "tip": {
        "title": "é + round lips = eu",
        "body": "There are two eu sounds, both with rounded lips and the tongue forward. Closed eu (deux, peu, bleu, heureuse): say é and round your lips. Open eu (peur, sœur, heure, jeune): say è and round your lips. As a rule of thumb, eu is closed at the end of a word and before a z-sound, and open before a pronounced consonant. Don't say \"er\" as in English — the r of peur is the French throat r."
      },
      "phrases": [
        {
          "t": "Il pleut.",
          "n": "It's raining."
        },
        {
          "t": "J'ai peur.",
          "n": "I'm scared."
        },
        {
          "t": "Ma sœur est heureuse.",
          "n": "My sister is happy.",
          "note": "sœur: open eu; heureuse ends in closed eu before the z sound."
        },
        {
          "t": "À tout à l'heure !",
          "n": "See you later!"
        }
      ],
      "pairs": [
        {
          "sound": "eu / é",
          "a": {
