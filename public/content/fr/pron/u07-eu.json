    {
      "id": "pron-u07-l2",
      "kind": "pron",
      "title": "eu, ou and u",
      "goal": "Keep deux, doux and du apart.",
      "tip": {
        "title": "Three rounded vowels, three tongue positions",
        "body": "All three are rounded, but the tongue moves: ou (doux) is at the back; u (du) is high and forward, as for \"ee\"; eu (deux) is forward but lower, as for \"é\". With your lips rounded the whole time, slide \"ou → eu → u\" and feel your tongue move forward and up. English speakers often turn eu into \"oo\" or \"er\" — keep the tongue forward and the lips round."
      },
      "phrases": [
        {
          "t": "Deux euros.",
          "n": "Two euros.",
          "note": "Liaison: \"deu-z-euros\"."
        },
        {
          "t": "Je veux bien.",
          "n": "I'd like that. / Yes, please."
        },
        {
          "t": "C'est un peu mieux.",
          "n": "It's a little better."
        },
        {
          "t": "C'est leur neveu.",
          "n": "It's their nephew."
        }
      ],
      "pairs": [
        {
          "sound": "eu / ou",
          "a": {
