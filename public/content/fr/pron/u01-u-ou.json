        {
          "t": "Tu vas où ?",
          "n": "Where are you going?",
          "mark": "Tu vas *où* ?",
          "note": "One group: the stress falls on the last syllable, \"où\"."
        },
        {
          "t": "Tout de suite !",
          "n": "Right away!",
          "mark": "Tout de *suite* !"
        }
