{
  "id": "pron-u01",
  "level": "A1",
  "title": "Le son u",
  "subtitle": "u vs ou",
  "icon": "👄",
  "lessons": [
    {
      "id": "pron-u01-l1",
      "kind": "pron",
      "title": "u and ou",
      "goal": "Hear and say u (tu) and ou (tout).",
      "tip": {
        "title": "Say \"ee\", then round your lips",
        "body": "French ou is close to English \"oo\" in \"food\": lips rounded, tongue pulled back. French u has no English equivalent: say \"ee\" as in \"see\", keep the tip of your tongue pressed behind your lower teeth, then push your lips into a tight round \"oo\" shape. If you hear \"oo\", your tongue has slipped back. So tu is not \"too\" — tout is."
      },
      "phrases": [
        {
          "t": "Salut !",
          "n": "Hi! / Bye!",
          "note": "The final t is silent: \"sa-lu\"."
        },
        {
          "t": "Tu vas où ?",
          "n": "Where are you going?"
        },
        {
          "t": "Tout de suite !",
          "n": "Right away!"
        },
        {
          "t": "Bien sûr !",
          "n": "Of course!"
        }
      ],
      "pairs": [
        {
          "sound": "u / ou",
          "a": {
            "t": "tu",
            "n": "you (informal)"
          },
          "b": {
            "t": "tout",
            "n": "all, everything"
          }
        },
