    {
      "id": "pron-u02-l1",
      "kind": "pron",
      "title": "an and on",
      "goal": "Hear and say vent and vont, blanc and blond.",
      "tip": {
        "title": "Air through the nose — no n at the end",
        "body": "For a nasal vowel, let air flow through your nose and mouth at the same time, and never close it off with an \"n\" or \"ng\" sound. an/en/am/em: open your mouth wide as for \"ah\" in \"father\", lips relaxed. on/om: round your lips tightly, almost as for \"oh\". The written n or m is just a spelling signal — you should not hear it."
      },
      "phrases": [
        {
          "t": "Enchanté !",
          "n": "Nice to meet you!",
          "note": "A woman writes \"Enchantée\", but it sounds the same."
        },
        {
          "t": "C'est bon !",
          "n": "It's good!"
        },
        {
          "t": "Dans un moment.",
          "n": "In a moment."
        },
        {
          "t": "Il fait du vent.",
          "n": "It's windy."
        }
      ],
      "pairs": [
