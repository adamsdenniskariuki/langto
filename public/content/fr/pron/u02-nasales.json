    {
      "id": "pron-u02-l2",
      "kind": "pron",
      "title": "in, and bon vs bonne",
      "goal": "Say vin and pain, and hear when the nasal disappears.",
      "tip": {
        "title": "in/ain/ein/un — and when the n comes back",
        "body": "in, im, ain, ein (vin, pain, plein) sound like the \"a\" in \"cat\" made nasal, with spread lips. In Paris and most of France un (brun, lundi) sounds the same as in, so you only need three nasal vowels. A nasal vowel exists only when the n/m is the last sound of the syllable: bon is nasal, but in bonne the n is pronounced and the vowel is plain — \"bonn\". The same happens in masculine/feminine pairs: cousin/cousine, canadien/canadienne."
      },
      "phrases": [
        {
          "t": "Du pain et du vin.",
          "n": "Bread and wine."
        },
        {
          "t": "Un bon vin blanc.",
          "n": "A good white wine.",
          "note": "Three different nasal vowels: un/in, on, an."
        },
        {
          "t": "Il est canadien.",
          "n": "He's Canadian."
        },
        {
          "t": "Elle est canadienne.",
          "n": "She's Canadian.",
          "note": "Not nasal: \"ca-na-dienn\"."
        }
      ],
      "pairs": [
        {
          "sound": "in / an",
          "a": {
            "t": "le vin",
            "n": "wine"
          },
          "b": {
            "t": "le vent",
