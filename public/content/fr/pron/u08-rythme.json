    {
      "id": "pron-u08-l2",
      "kind": "pron",
      "title": "Linking: enchaînement",
      "goal": "Run words together the French way.",
      "tip": {
        "title": "Words flow into each other",
        "body": "In French, a pronounced final consonant moves over to the next word if it starts with a vowel (enchaînement): il a → \"i-la\", avec elle → \"a-vè-kel\", une amie → \"u-na-mie\". Syllables like to be open (consonant + vowel), so speech sounds like one smooth chain. Long sentences are cut into groups: each non-final group ends slightly higher and longer, the last one falls. Because of linking, il a dit and il l'a dit differ only in a longer l."
      },
      "phrases": [
        {
          "t": "Il a une amie à Paris.",
          "n": "He has a friend in Paris.",
          "note": "\"i-la-u-na-mi-a-pa-ri\""
        },
        {
          "t": "Avec elle ?",
          "n": "With her?"
        },
        {
          "t": "Elle arrive à huit heures.",
          "n": "She's arriving at eight o'clock."
        },
        {
          "t": "Le matin, je prends le bus, et le soir, je rentre à pied.",
          "n": "In the morning I take the bus, and in the evening I walk home."
        }
      ],
      "pairs": [
        {
          "sound": "l / long l",
          "a": {
            "t": "Il a dit.",
            "n": "He said."
          },
          "b": {
            "t": "Il l'a dit.",
            "n": "He said it."
          }
        },
        {
          "sound": "l / long l",
          "a": {
            "t": "Il a vu.",
            "n": "He saw."
          },
          "b": {
            "t": "Il l'a vu.",
            "n": "He saw it."
          }
        },
        {
          "sound": "l / long l",
          "a": {
            "t": "Elle aime.",
            "n": "She loves."
          },
          "b": {
            "t": "Elle l'aime.",
            "n": "She loves him/her."
          }
        },
        {
          "sound": "l / long l",
          "a": {
            "t": "Il apprend.",
            "n": "He's learning."
          },
          "b": {
            "t": "Il l'apprend.",
            "n": "He's learning it."
          }
        },
        {
          "sound": "l / long l",
          "a": {
            "t": "Elle attend.",
            "n": "She's waiting."
          },
          "b": {
            "t": "Elle l'attend.",
            "n": "She's waiting for him/her."
          }
        }
      ],
      "stress": [
        {
          "t": "Il a une amie à Paris.",
          "n": "He has a friend in Paris.",
          "mark": "Il a une a*mie* à Pa*ris*."
        },
