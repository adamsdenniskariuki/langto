    {
      "id": "pron-u08-l1",
      "kind": "pron",
      "title": "Even syllables, final stress",
      "goal": "Give each syllable its full weight and stress the end of each group.",
      "tip": {
        "title": "No word stress — group stress",
        "body": "French is syllable-timed: every syllable gets roughly the same length and a full vowel — no English-style swallowed syllables. Words have no fixed stress of their own; instead the last syllable of each rhythmic group (a short chunk of meaning) is slightly longer. As a group grows, the stress moves to its new end: un ca-FÉ, un café CRÈME. Loanwords lose their English stress too: Ca-na-DA, un sand-WICH, le res-tau-RANT."
      },
      "phrases": [
        {
          "t": "Canada",
          "n": "Canada",
          "note": "Stress at the end: Ca-na-DA."
        },
        {
          "t": "un sandwich au jambon",
          "n": "a ham sandwich"
        },
        {
          "t": "le restaurant",
          "n": "the restaurant"
        },
        {
          "t": "C'est une bonne idée.",
          "n": "That's a good idea."
        }
      ],
      "pairs": [
