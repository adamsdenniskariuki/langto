    {
      "id": "pron-u04-l1",
      "kind": "pron",
      "title": "Silent final consonants",
      "goal": "Know which final letters to skip — and which to say.",
      "tip": {
        "title": "Most final consonants are silent — be CaReFuL",
        "body": "At the end of a word, most consonants are silent: petit, grand, trop, vous, froid. The usual exceptions are C, R, F and L (think \"careful\"): sac, mer, neuf, sel — though -er in infinitives and many nouns sounds like \"é\" (parler, le boulanger). A final e is silent too, but it makes the consonant before it heard: petit (\"p'ti\") vs petite (\"p'tit\"). That's how you hear masculine vs feminine."
      },
      "phrases": [
        {
          "t": "Il est petit.",
          "n": "He's small."
        },
        {
          "t": "Elle est petite.",
          "n": "She's small.",
          "note": "The t is now pronounced."
        },
        {
          "t": "Il fait froid.",
          "n": "It's cold.",
          "note": "The d is silent."
        },
        {
          "t": "Le chef a un sac.",
          "n": "The chef has a bag.",
          "note": "f and c are pronounced (CaReFuL)."
        }
      ],
      "pairs": [
        {
          "sound": "silent / pronounced",
          "a": {
            "t": "petit",
            "n": "small (m)"
          },
          "b": {
            "t": "petite",
            "n": "small (f)"
          }
        },
        {
          "sound": "silent / pronounced",
          "a": {
            "t": "grand",
            "n": "tall (m)"
          },
          "b": {
