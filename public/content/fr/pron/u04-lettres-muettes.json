    {
      "id": "pron-u04-l2",
      "kind": "pron",
      "title": "Silent -ent and the h",
      "goal": "Skip -ent in verbs and handle h muet and h aspiré.",
      "tip": {
        "title": "-ent is silent in verbs; h is never pronounced",
        "body": "The verb ending -ent is silent: ils parlent sounds exactly like il parle. (Not in other words: souvent, le vent.) With -er verbs you hear the plural only when the verb starts with a vowel, through the z of the liaison: ils_aiment. The letter h is never pronounced. Most h's are \"mute\" and behave like a vowel: l'homme, les_hommes. Some (h aspiré, often in words of Germanic origin) block élision and liaison: le héros, les | haricots — no z."
      },
      "phrases": [
        {
          "t": "Ils parlent vite.",
          "n": "They speak fast.",
          "note": "-ent is silent: sounds like \"il parle vite\"."
        },
        {
          "t": "Ils habitent à Lyon.",
          "n": "They live in Lyon.",
          "note": "h muet: liaison \"il-z-abit\"."
        },
        {
          "t": "J'aime les haricots.",
          "n": "I like green beans.",
          "note": "h aspiré: no liaison, no élision."
        },
        {
          "t": "C'est l'heure !",
          "n": "It's time!"
        }
      ],
      "pairs": [
        {
          "sound": "no liaison / liaison",
          "a": {
            "t": "il aime",
            "n": "he likes"
          },
          "b": {
            "t": "ils aiment",
            "n": "they like"
          }
        },
        {
          "sound": "no liaison / liaison",
          "a": {
            "t": "elle écoute",
            "n": "she listens"
          },
          "b": {
            "t": "elles écoutent",
            "n": "they listen"
          }
        },
        {
          "sound": "no liaison / liaison",
