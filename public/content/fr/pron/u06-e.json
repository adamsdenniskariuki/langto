    {
      "id": "pron-u06-l2",
      "kind": "pron",
      "title": "The e that disappears",
      "goal": "Hear je vs j'ai, and drop the e caduc like a native.",
      "tip": {
        "title": "e caduc: weak, and often silent",
        "body": "Unstressed e without an accent (le, je, de, ne, que, ce, and inside words like samedi, maintenant, petit) is a short, relaxed vowel — and in everyday speech it often vanishes: \"sam'di\", \"maint'nant\", \"p'tit\", \"j'sais pas\". It stays when dropping it would bring three consonants together (vendredi, quelque chose) and in careful speech, poetry and song. Keep it distinct from é: je dis (present) vs j'ai dit (past) differ only in that vowel."
      },
      "phrases": [
        {
          "t": "Je ne sais pas.",
          "n": "I don't know.",
          "note": "Casual: \"j'sais pas\" or even \"chais pas\"."
        },
        {
          "t": "À samedi !",
          "n": "See you on Saturday!",
          "note": "Casual: \"sam'di\"."
        },
        {
          "t": "Il est petit.",
          "n": "He's small.",
          "note": "Casual: \"il est p'tit\"."
        },
        {
          "t": "Qu'est-ce que tu fais maintenant ?",
          "n": "What are you doing now?",
          "note": "Casual: \"qu'est-c'que tu fais maint'nant ?\""
        }
      ],
      "pairs": [
        {
          "sound": "e / é",
