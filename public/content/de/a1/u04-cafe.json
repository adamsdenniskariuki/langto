          "n": "Two bread rolls, please."
        },
        {
          "t": "Haben Sie Apfelkuchen?",
          "n": "Do you have apple cake?"
        },
        {
          "t": "Für hier oder zum Mitnehmen?",
          "n": "For here or to take away?"
        },
        {
          "t": "Zum Mitnehmen, bitte.",
          "n": "To take away, please."
        },
        {
          "t": "Das ist alles.",
          "n": "That's all."
