    {
      "id": "u04-l1",
      "title": "Ordering a drink",
      "goal": "Order food and drinks politely.",
      "tip": {
        "title": "der, die, das → einen, eine, ein",
        "body": "Every noun has a gender. When you order something, masculine words change: der Kaffee → einen Kaffee. Feminine and neuter stay: eine Cola, ein Wasser. Ich hätte gern … is the politest way to order."
      },
      "phrases": [
        {
          "t": "Was möchten Sie?",
          "n": "What would you like?"
        },
        {
          "t": "Ich hätte gern einen Kaffee.",
          "n": "I'd like a coffee."
        },
        {
          "t": "Einen Tee, bitte.",
          "n": "A tea, please."
        },
        {
          "t": "Ein Wasser, bitte.",
          "n": "A water, please."
        },
        {
          "t": "Ich nehme ein Stück Kuchen.",
          "n": "I'll take a piece of cake."
        },
        {
          "t": "Mit Milch, bitte.",
          "n": "With milk, please."
        },
        {
          "t": "Ohne Zucker.",
          "n": "Without sugar."
        }
      ],
      "dialogue": {
        "voice": "de-DE-AmalaNeural",
        "title": "At the counter",
        "lines": [
          {
            "who": "A",
            "name": "Kellnerin",
            "t": "Guten Tag! Was möchten Sie?",
            "n": "Hello! What would you like?"
          },
          {
            "who": "you",
            "t": "Ich hätte gern einen Kaffee, bitte.",
            "n": "I'd like a coffee, please."
          },
          {
            "who": "A",
            "name": "Kellnerin",
            "t": "Mit Milch und Zucker?",
            "n": "With milk and sugar?"
          },
          {
            "who": "you",
            "t": "Mit Milch, ohne Zucker.",
            "n": "With milk, without sugar."
          },
          {
            "who": "A",
            "name": "Kellnerin",
            "t": "Gern. Sonst noch etwas?",
            "n": "Sure. Anything else?"
          },
          {
            "who": "you",
            "t": "Ich nehme ein Stück Kuchen.",
            "n": "I'll take a piece of cake."
          }
        ]
      },
      "prompts": [
