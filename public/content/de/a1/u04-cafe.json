    {
      "id": "u04-l2",
      "title": "Paying the bill",
      "goal": "Ask for the bill and pay.",
      "tip": {
        "title": "Tipping",
        "body": "In Germany you usually round up and tell the server the total you want to pay, or say Stimmt so! (keep the change). Many cafés ask Zusammen oder getrennt? — together or separately?"
      },
      "phrases": [
        {
          "t": "Die Rechnung, bitte!",
          "n": "The bill, please!"
        },
        {
          "t": "Zahlen, bitte!",
          "n": "We'd like to pay, please!"
        },
        {
          "t": "Was macht das?",
          "n": "How much is that?"
        },
        {
          "t": "Das macht sieben Euro.",
          "n": "That's seven euros."
        },
        {
          "t": "Zusammen oder getrennt?",
          "n": "Together or separately?"
        },
        {
          "t": "Getrennt, bitte.",
          "n": "Separately, please."
        },
        {
          "t": "Stimmt so!",
          "n": "Keep the change!"
        },
        {
          "t": "Kann ich mit Karte zahlen?",
          "n": "Can I pay by card?"
        }
      ],
      "dialogue": {
        "title": "Time to go",
        "lines": [
          {
            "who": "you",
            "t": "Zahlen, bitte!",
            "n": "We'd like to pay, please!"
          },
          {
            "who": "A",
            "name": "Kellner",
            "t": "Zusammen oder getrennt?",
            "n": "Together or separately?"
          },
          {
            "who": "you",
            "t": "Zusammen. Was macht das?",
            "n": "Together. How much is that?"
          },
          {
            "who": "A",
            "name": "Kellner",
            "t": "Das macht neun Euro.",
            "n": "That's nine euros."
          },
          {
            "who": "you",
            "t": "Zehn Euro. Stimmt so!",
            "n": "Ten euros. Keep the change!"
          },
          {
            "who": "A",
            "name": "Kellner",
            "t": "Vielen Dank! Schönen Tag noch!",
            "n": "Many thanks! Have a nice day!"
          }
        ]
      },
      "prompts": [
        {
          "n": "Ask for the bill.",
