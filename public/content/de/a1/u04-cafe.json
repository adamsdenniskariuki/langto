    {
      "id": "u04-l4",
      "kind": "grammar",
      "title": "möchten + einen, eine, ein",
      "goal": "Order anything with the right article.",
      "tip": {
        "title": "What you order changes the article",
        "body": "möchten: ich möchte, du möchtest, er/sie möchte, wir/Sie möchten. The thing you order is the object (accusative): masculine der Tee becomes einen Tee. Feminine eine Cola and neuter ein Wasser stay the same."
      },
      "phrases": [
        {
          "t": "Ich möchte einen Tee.",
          "n": "I'd like a tea."
        },
        {
          "t": "Möchtest du eine Cola?",
          "n": "Would you like a cola?"
        },
        {
          "t": "Er möchte ein Wasser.",
          "n": "He'd like a water."
        },
        {
          "t": "Wir möchten zwei Kaffee.",
          "n": "We'd like two coffees.",
          "note": "When ordering, Kaffee often stays singular."
        },
        {
          "t": "Möchten Sie Milch?",
          "n": "Would you like milk?"
        }
      ],
