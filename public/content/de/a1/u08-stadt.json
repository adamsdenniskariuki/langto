            },
            {
              "cue": "die Bank",
              "t": "Wie komme ich zur Bank?",
              "n": "How do I get to the bank?"
            }
          ]
        },
        {
          "title": "Swap the instruction",
          "base": {
            "t": "Gehen Sie geradeaus.",
            "n": "Go straight ahead."
          },
          "items": [
            {
              "cue": "nach rechts",
              "t": "Gehen Sie nach rechts.",
              "n": "Go to the right."
            },
            {
              "cue": "nehmen · den Bus",
              "t": "Nehmen Sie den Bus.",
              "n": "Take the bus."
            },
            {
              "cue": "nehmen · die zweite Straße links",
              "t": "Nehmen Sie die zweite Straße links.",
              "n": "Take the second street on the left."
