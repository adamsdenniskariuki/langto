    {
      "id": "u08-l1",
      "title": "Where is …?",
      "goal": "Ask for and understand directions.",
      "tip": {
        "title": "zum or zur?",
        "body": "Wie komme ich … (how do I get …) uses zum for masculine/neuter places (zum Bahnhof, zum Museum) and zur for feminine ones (zur Post)."
      },
      "phrases": [
        {
          "t": "Wo ist der Bahnhof?",
          "n": "Where is the train station?"
        },
        {
          "t": "Wo ist die Toilette?",
          "n": "Where is the toilet?"
        },
        {
          "t": "Wie komme ich zum Museum?",
          "n": "How do I get to the museum?"
        },
        {
          "t": "Geradeaus.",
          "n": "Straight ahead."
        },
        {
          "t": "Nach links.",
          "n": "To the left."
        },
        {
          "t": "Nach rechts.",
          "n": "To the right."
        },
        {
          "t": "Ist es weit?",
          "n": "Is it far?"
        },
        {
          "t": "Nein, es ist ganz nah.",
          "n": "No, it's very close."
        }
      ],
      "dialogue": {
        "title": "Lost in Munich",
        "lines": [
          {
            "who": "you",
            "t": "Entschuldigung, wie komme ich zum Bahnhof?",
            "n": "Excuse me, how do I get to the station?"
          },
          {
            "who": "A",
            "name": "Passant",
            "t": "Geradeaus und dann nach links.",
            "n": "Straight ahead and then left."
          },
          {
            "who": "you",
            "t": "Ist es weit?",
            "n": "Is it far?"
          },
          {
            "who": "A",
            "name": "Passant",
            "t": "Nein, es ist ganz nah. Fünf Minuten.",
            "n": "No, it's very close. Five minutes."
          },
          {
            "who": "you",
            "t": "Vielen Dank!",
            "n": "Many thanks!"
          }
        ]
      },
      "prompts": [
        {
          "n": "Ask where the toilet is.",
          "t": [
            "Wo ist die Toilette",
            "Entschuldigung wo ist die Toilette"
          ]
        },
        {
          "n": "Ask how to get to the museum.",
          "t": [
            "Wie komme ich zum Museum"
          ]
        },
        {
          "n": "Ask whether it's far.",
          "t": [
            "Ist es weit",
            "Ist das weit"
          ]
        }
      ]
    },
