    {
      "id": "u08-l4",
      "kind": "grammar",
      "title": "Gehen Sie geradeaus!",
      "goal": "Give polite directions and use zum / zur.",
      "tip": {
        "title": "Verb first, then Sie",
        "body": "To tell a stranger what to do, put the verb first and add Sie: Gehen Sie geradeaus! Nehmen Sie den Bus! For destinations use zum with der/das words (zum Bahnhof, zum Hotel) and zur with die words (zur Post, zur Bank)."
      },
      "phrases": [
        {
          "t": "Gehen Sie geradeaus.",
          "n": "Go straight ahead."
        },
        {
          "t": "Nehmen Sie die erste Straße links.",
          "n": "Take the first street on the left."
        },
        {
          "t": "Fahren Sie mit der U-Bahn.",
          "n": "Take the underground."
        },
        {
          "t": "Wie komme ich zur Post?",
          "n": "How do I get to the post office?"
        },
        {
          "t": "Wie komme ich zum Hotel?",
          "n": "How do I get to the hotel?"
        }
      ],
      "drills": [
        {
          "title": "Swap the place (zum / zur)",
