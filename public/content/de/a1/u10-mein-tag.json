    {
      "id": "u10-l4",
      "kind": "grammar",
      "title": "Separable verbs",
      "goal": "Put the prefix in the right place.",
      "tip": {
        "title": "Prefix to the end",
        "body": "Verbs like aufstehen, einkaufen, anrufen and fernsehen split in the present tense: the verb is in second place and the prefix goes to the very end — Am Montag stehe ich früh auf. With möchten or können the verb stays in one piece at the end: Ich möchte heute einkaufen."
      },
      "phrases": [
        {
          "t": "Ich stehe früh auf.",
          "n": "I get up early."
        },
        {
          "t": "Wann kaufst du ein?",
          "n": "When do you go shopping?"
        },
        {
          "t": "Er ruft seine Schwester an.",
          "n": "He's calling his sister."
        },
        {
          "t": "Wir sehen am Abend fern.",
          "n": "We watch TV in the evening."
        },
        {
          "t": "Ich möchte heute einkaufen.",
          "n": "I'd like to go shopping today."
        }
      ],
      "drills": [
        {
          "title": "Swap the verb",
          "base": {
            "t": "Ich stehe um sieben Uhr auf.",
            "n": "I get up at seven o'clock."
          },
          "items": [
            {
              "cue": "einkaufen · um zehn",
              "t": "Ich kaufe um zehn Uhr ein.",
              "n": "I go shopping at ten o'clock."
            },
            {
              "cue": "anrufen · Anna · um acht",
              "t": "Ich rufe Anna um acht Uhr an.",
              "n": "I call Anna at eight o'clock."
            },
            {
              "cue": "fernsehen · um neun",
              "t": "Ich sehe um neun Uhr fern.",
              "n": "I watch TV at nine o'clock."
            }
          ]
        },
        {
          "title": "Swap in möchten / können",
          "base": {
            "t": "Ich kaufe heute ein.",
            "n": "I'm going shopping today."
          },
          "items": [
            {
              "cue": "möchten",
              "t": "Ich möchte heute einkaufen.",
              "n": "I'd like to go shopping today."
            },
            {
              "cue": "können · nicht",
              "t": "Ich kann heute nicht einkaufen.",
              "n": "I can't go shopping today."
            },
            {
              "cue": "du · möchten?",
              "t": "Möchtest du heute einkaufen?",
              "n": "Would you like to go shopping today?"
            }
          ]
        }
      ],
      "prompts": [
        {
          "n": "Say you get up early.",
          "t": [
            "Ich stehe früh auf"
          ]
        },
        {
          "n": "Ask a friend when they go shopping.",
          "t": [
            "Wann kaufst du ein",
            "Wann gehst du einkaufen"
          ]
        }
      ]
    },
