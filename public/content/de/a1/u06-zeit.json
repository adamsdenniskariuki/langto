    {
      "id": "u06-l2",
      "title": "What time is it?",
      "goal": "Ask and tell the time.",
      "tip": {
        "title": "halb vier = 3:30!",
        "body": "Germans say half TO the next hour: halb vier means half (on the way) to four — 3:30. Viertel nach zwei = quarter past two."
      },
      "phrases": [
        {
          "t": "Wie spät ist es?",
          "n": "What time is it?"
        },
        {
          "t": "Es ist drei Uhr.",
          "n": "It's three o'clock."
        },
        {
          "t": "Es ist halb vier.",
          "n": "It's half past three."
        },
        {
          "t": "Es ist Viertel nach zwei.",
          "n": "It's quarter past two."
        },
        {
          "t": "Um wie viel Uhr?",
          "n": "At what time?"
        },
        {
          "t": "Um acht Uhr.",
          "n": "At eight o'clock."
        },
        {
          "t": "Ich habe keine Zeit.",
          "n": "I don't have time."
        }
      ],
      "dialogue": {
        "voice": "de-DE-AmalaNeural",
        "title": "Running late",
        "lines": [
          {
            "who": "you",
            "t": "Entschuldigung, wie spät ist es?",
            "n": "Excuse me, what time is it?"
          },
          {
            "who": "A",
