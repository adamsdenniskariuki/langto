              "n": "At nine o'clock I work."
            },
            {
              "cue": "Am Samstag · nicht",
              "t": "Am Samstag arbeite ich nicht.",
              "n": "On Saturday I don't work."
            }
          ]
        },
        {
          "title": "Swap: start with the time",
          "base": {
            "t": "Ich lerne heute Deutsch.",
            "n": "I'm learning German today."
          },
          "items": [
            {
              "cue": "Heute …",
              "t": "Heute lerne ich Deutsch.",
              "n": "Today I'm learning German."
            },
            {
              "cue": "Am Abend …",
              "t": "Am Abend lerne ich Deutsch.",
              "n": "In the evening I learn German."
            },
            {
              "cue": "Um sieben Uhr …",
              "t": "Um sieben Uhr lerne ich Deutsch.",
              "n": "At seven o'clock I learn German."
            }
          ]
        }
