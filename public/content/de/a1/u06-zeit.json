    {
      "id": "u06-l4",
      "kind": "grammar",
      "title": "Time first, verb second",
      "goal": "Start a sentence with a time and keep the verb in place.",
      "tip": {
        "title": "The verb stays in slot two",
        "body": "In a German statement the verb is always the second element. If you start with a time — Heute, Am Montag, Um acht Uhr — the subject moves behind the verb: Ich arbeite am Montag → Am Montag arbeite ich."
      },
      "phrases": [
        {
          "t": "Ich arbeite am Montag.",
          "n": "I work on Monday."
        },
        {
          "t": "Am Montag arbeite ich.",
          "n": "On Monday I work."
        },
        {
          "t": "Heute lerne ich Deutsch.",
          "n": "Today I'm learning German."
        },
        {
          "t": "Um acht Uhr stehe ich auf.",
          "n": "At eight o'clock I get up."
        },
        {
          "t": "Am Wochenende habe ich Zeit.",
          "n": "At the weekend I have time."
        }
      ],
      "drills": [
        {
          "title": "Swap the time",
          "base": {
            "t": "Am Montag arbeite ich.",
