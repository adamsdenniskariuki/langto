    {
      "id": "u01-l4",
      "kind": "grammar",
      "title": "du or Sie: the verb changes",
      "goal": "Ask questions with du and Sie correctly.",
      "tip": {
        "title": "Verb endings follow the person",
        "body": "German verbs change their ending: ich heiße, du heißt, Sie heißen. With Sie the verb looks like the infinitive. Swap the person and the ending follows."
      },
      "phrases": [
        { "t": "Wie heißt du?", "n": "What's your name? (informal)" },
        { "t": "Wie heißen Sie?", "n": "What's your name? (formal)" },
        { "t": "Ich heiße Tom.", "n": "My name is Tom." },
        { "t": "Woher kommst du?", "n": "Where are you from? (informal)" },
        { "t": "Woher kommen Sie?", "n": "Where are you from? (formal)" }
      ],
      "drills": [
        {
          "title": "Swap du → Sie",
          "base": { "t": "Wie geht es dir?", "n": "How are you? (informal)" },
          "items": [
            { "cue": "Sie", "t": "Wie geht es Ihnen?", "n": "How are you? (formal)" },
            { "cue": "heißen · Sie", "t": "Wie heißen Sie?", "n": "What's your name? (formal)" },
            { "cue": "kommen · Sie", "t": "Woher kommen Sie?", "n": "Where are you from? (formal)" }
          ]
        },
        {
          "title": "Swap the name",
          "base": { "t": "Ich heiße Tom.", "n": "My name is Tom." },
          "items": [
            { "cue": "Anna", "t": "Ich heiße Anna.", "n": "My name is Anna." },
            { "cue": "du · Lena?", "t": "Heißt du Lena?", "n": "Is your name Lena?" },
            { "cue": "Sie · Weber?", "t": "Heißen Sie Weber?", "n": "Is your name Weber?" }
          ]
        }
      ],
      "prompts": [
        { "n": "Ask a child what their name is.", "t": ["Wie heißt du"] },
        { "n": "Ask a hotel receptionist where she is from.", "t": ["Woher kommen Sie"] }
      ]
    },
