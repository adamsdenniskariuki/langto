          { "who": "you", "t": "Nein, danke.", "n": "No, thank you." }
        ]
      },
      "prompts": [
        { "n": "Someone holds the door for you. Thank them warmly.", "t": ["Danke schön", "Vielen Dank", "Danke"] },
        { "n": "You stepped on someone's foot.", "t": ["Entschuldigung"] },
        { "n": "Someone thanks you. Reply.", "t": ["Bitte schön", "Bitte", "Kein Problem"] }
