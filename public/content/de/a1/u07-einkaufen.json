      "tip": {
        "title": "Ich möchte …",
        "body": "Ich möchte (I would like) is your best friend in shops. Plurals vary: ein Brötchen → drei Brötchen, ein Apfel → zwei Äpfel."
      },
      "phrases": [
        {
          "t": "Ich möchte ein Brot.",
          "n": "I'd like a loaf of bread."
