    {
      "id": "u02-l1",
      "title": "What's your name?",
      "goal": "Say your name and ask for someone else's.",
      "tip": {
        "title": "ei vs. ie",
        "body": "Read the second letter: ei sounds like English \"eye\" (heiße, mein), ie sounds like \"ee\" (sie, Wiedersehen). ß is just a sharp \"ss\"."
      },
      "phrases": [
        {
          "t": "Ich heiße Anna.",
          "n": "My name is Anna."
        },
        {
          "t": "Wie heißt du?",
          "n": "What's your name? (informal)"
        },
        {
          "t": "Wie heißen Sie?",
          "n": "What's your name? (formal)"
        },
        {
          "t": "Ich bin Tom.",
          "n": "I'm Tom."
        },
        {
          "t": "Mein Name ist Müller.",
          "n": "My name is Müller."
        },
        {
          "t": "Freut mich!",
          "n": "Nice to meet you!"
        },
        {
          "t": "Freut mich auch!",
          "n": "Nice to meet you too!"
        }
      ],
