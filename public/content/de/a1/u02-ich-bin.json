    {
      "id": "u02-l4",
      "kind": "grammar",
      "title": "sein & W-questions",
      "goal": "Use bin/bist/ist and ask who, where and where from.",
      "tip": {
        "title": "sein is irregular — the verb comes second",
        "body": "sein (to be) has its own forms: ich bin, du bist, er/sie ist, Sie sind. Regular verbs add -t for er/sie: er kommt, sie wohnt. In W-questions (wer, wie, wo, woher) the verb always comes second: Wo wohnt sie?"
      },
      "phrases": [
        {
          "t": "Wer ist das?",
          "n": "Who is that?"
        },
        {
          "t": "Das ist Jonas.",
          "n": "That's Jonas."
        },
        {
          "t": "Er kommt aus Österreich.",
          "n": "He's from Austria."
        },
        {
          "t": "Sie wohnt in München.",
          "n": "She lives in Munich."
        },
        {
          "t": "Wo wohnen Sie?",
          "n": "Where do you live? (formal)"
        }
      ],
      "drills": [
        {
          "title": "Swap the person (sein)",
