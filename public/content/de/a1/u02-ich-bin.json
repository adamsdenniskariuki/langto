            },
            {
              "cue": "Sie (formal)",
              "t": "Sie sind neu hier.",
              "n": "You're new here. (formal)"
            }
          ]
        },
        {
          "title": "Swap the question word",
          "base": {
            "t": "Wie heißt du?",
            "n": "What's your name?"
