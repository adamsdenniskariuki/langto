    {
      "id": "u02-l3",
      "title": "Survival phrases",
      "goal": "Keep a conversation going when you don't understand.",
      "tip": {
        "title": "Your secret weapon",
        "body": "These phrases keep any conversation alive. Native speakers are happy to slow down — just ask. The German r is soft, made at the back of the throat, almost like a gentle gargle."
      },
      "phrases": [
        {
          "t": "Sprichst du Englisch?",
          "n": "Do you speak English?"
        },
        {
          "t": "Ein bisschen.",
          "n": "A little."
        },
        {
          "t": "Ich verstehe nicht.",
          "n": "I don't understand."
        },
        {
          "t": "Wie bitte?",
          "n": "Pardon?"
        },
        {
          "t": "Noch einmal, bitte.",
          "n": "Once more, please."
        },
        {
          "t": "Langsamer, bitte.",
          "n": "Slower, please."
        },
        {
          "t": "Was bedeutet das?",
          "n": "What does that mean?"
        }
      ],
      "dialogue": {
        "title": "Asking for help",
        "lines": [
          {
            "who": "A",
            "name": "Verkäufer",
            "t": "Möchten Sie eine Tüte?",
            "n": "Would you like a bag?"
          },
          {
            "who": "you",
            "t": "Wie bitte? Langsamer, bitte.",
            "n": "Pardon? Slower, please."
          },
          {
            "who": "A",
            "name": "Verkäufer",
            "t": "Eine Tüte?",
            "n": "A bag?"
          },
          {
            "who": "you",
            "t": "Was bedeutet das?",
            "n": "What does that mean?"
          },
          {
            "who": "A",
            "name": "Verkäufer",
            "t": "A bag!",
            "n": "A bag!"
          },
          {
            "who": "you",
            "t": "Ah! Nein, danke.",
            "n": "Ah! No, thank you."
          }
        ]
      },
      "prompts": [
        {
          "n": "You didn't catch that. Ask them to repeat.",
