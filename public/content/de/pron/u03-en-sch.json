          "a": {
            "t": "Messe",
            "n": "trade fair"
          },
          "b": {
            "t": "Messer",
            "n": "knife"
          }
        },
        {
          "sound": "-e / -er",
          "a": {
            "t": "Lehre",
            "n": "apprenticeship"
          },
          "b": {
            "t": "Lehrer",
            "n": "teacher"
          }
        },
        {
          "sound": "-e / -en",
          "a": {
            "t": "Liebe",
            "n": "love"
          },
          "b": {
            "t": "lieben",
            "n": "to love"
          }
        },
        {
          "sound": "-e / -en",
          "a": {
            "t": "Rose",
            "n": "rose"
          },
          "b": {
            "t": "Rosen",
            "n": "roses"
          }
        },
        {
          "sound": "-e / -en",
          "a": {
            "t": "Woche",
