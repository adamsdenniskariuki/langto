    },
    {
      "id": "pron-u03-l2",
      "kind": "pron",
      "title": "st and sp",
      "goal": "Say \"scht\" and \"schp\" at the start of words.",
      "tip": {
        "title": "S becomes sh",
        "body": "At the start of a word or word part, st sounds like \"sht\" and sp like \"shp\": Stein = \"shtein\", Sport = \"shport\". A single s before a vowel is a buzzing \"z\": Sand = \"zand\"."
      },
      "phrases": [
        {
          "t": "Ich spiele Fußball.",
          "n": "I play football."
        },
        {
          "t": "Die Straße ist lang.",
          "n": "The street is long."
        },
        {
          "t": "Sport ist super!",
          "n": "Sport is great!"
        },
        {
          "t": "Es ist schon spät.",
          "n": "It's already late."
        }
      ],
      "pairs": [
        {
          "sound": "st / sch",
          "a": {
            "t": "Stein",
            "n": "stone"
          },
          "b": {
            "t": "Schein",
            "n": "banknote"
          }
        },
        {
