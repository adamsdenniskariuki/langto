{
  "id": "pron-u03",
  "level": "A1",
  "title": "Endings & sch",
  "subtitle": "-e, -en, -er · st, sp",
  "icon": "🗣️",
  "lessons": [
    {
      "id": "pron-u03-l1",
      "kind": "pron",
      "title": "Weak endings",
      "goal": "Say -e, -en and -er the German way.",
      "tip": {
        "title": "Relax the ending",
        "body": "Final -e is a short, relaxed \"uh\" (like the \"a\" in \"sofa\"). In -en the e almost disappears: \"kommen\" sounds like \"komm'n\". Final -er sounds like a short open \"a\": \"Lehrer\" ≈ \"Lehra\"."
      },
      "phrases": [
        {
          "t": "Bitte schön!",
          "n": "You're welcome!"
        },
        {
          "t": "Wir kommen morgen.",
          "n": "We're coming tomorrow."
        },
        {
          "t": "Mein Bruder ist Lehrer.",
          "n": "My brother is a teacher."
        },
        {
          "t": "Haben Sie Wasser?",
          "n": "Do you have water?"
        }
      ],
      "pairs": [
        {
          "sound": "-e / -er",
          "a": {
            "t": "bitte",
            "n": "please"
          },
          "b": {
            "t": "bitter",
            "n": "bitter"
          }
        },
        {
