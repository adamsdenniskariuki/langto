  "title": "Umlaute",
  "subtitle": "ü, ö, ä vs u, o, a",
  "icon": "👄",
  "lessons": [
    {
      "id": "pron-u01-l1",
      "kind": "pron",
      "title": "ü and ö",
      "goal": "Hear and say ü/u and ö/o.",
      "tip": {
        "title": "Round your lips, think \"ee\"",
        "body": "For ü, say \"ee\" as in \"see\", then round your lips tightly as for \"oo\" — keep the tongue forward. For ö, say \"ay\" as in \"say\" and round your lips. Don't slide into \"oo\" or \"oh\"."
      },
      "phrases": [
        {
          "t": "schön",
          "n": "beautiful"
        },
        {
          "t": "Grüß dich!",
          "n": "Hi!"
        },
        {
          "t": "Brötchen",
          "n": "bread roll"
        },
        {
          "t": "fünf Bücher",
          "n": "five books"
        }
      ],
      "pairs": [
