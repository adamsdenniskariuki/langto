    {
      "id": "pron-u01-l2",
      "kind": "pron",
      "title": "ä, ü and ö again",
      "goal": "Tell ä from a, ü from i, ö from e.",
      "tip": {
        "title": "Spread vs round",
        "body": "ä is like \"e\" in \"bed\" (long ä like \"air\" without the r). ü and i use the same tongue position — only the lips change: spread for i, rounded for ü. Same for e (spread) and ö (rounded)."
      },
      "phrases": [
