    {
      "id": "pron-u06-l1",
      "kind": "pron",
      "title": "Long and short a, i",
      "goal": "Hear vowel length — it changes meaning.",
      "tip": {
        "title": "Length is meaning",
        "body": "Long vowels are tense and held (Staat, Miete); short vowels are lax and quick, followed by a firm consonant (Stadt, Mitte). Spelling helps: double vowels, h or ie mean long; double consonants mean short."
      },
      "phrases": [
        {
          "t": "Die Miete ist zu hoch.",
          "n": "The rent is too high."
        },
        {
          "t": "Wir wohnen in der Stadtmitte.",
          "n": "We live in the city centre."
        },
        {
          "t": "Ich bin satt, danke.",
          "n": "I'm full, thanks."
        },
        {
          "t": "Ich kenne ihn.",
          "n": "I know him."
        }
      ],
      "pairs": [
        {
          "sound": "long a / short a",
          "a": {
            "t": "Staat",
            "n": "state"
          },
          "b": {
            "t": "Stadt",
            "n": "city"
          }
        },
