          "a": {
            "t": "Saat",
            "n": "seed"
          },
          "b": {
            "t": "satt",
            "n": "full"
          }
        },
        {
          "sound": "long i / short i",
          "a": {
            "t": "Miete",
            "n": "rent"
          },
          "b": {
            "t": "Mitte",
            "n": "middle"
          }
        },
        {
          "sound": "long i / short i",
          "a": {
            "t": "Bienen",
            "n": "bees"
          },
          "b": {
            "t": "binnen",
            "n": "within"
          }
        },
        {
          "sound": "long i / short i",
          "a": {
            "t": "ihn",
