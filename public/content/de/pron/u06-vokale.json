      "stress": [
        {
          "t": "Die Miete ist zu hoch.",
          "n": "The rent is too high.",
          "mark": "Die *Mie*te ist zu *hoch*."
        },
        {
          "t": "Wir wohnen in der Stadtmitte.",
          "n": "We live in the city centre.",
          "mark": "Wir *woh*nen in der *Stadt*mitte.",
          "note": "In compounds the first part carries the main stress."
        }
      ],
      "prompts": [
        {
          "n": "Say you're full.",
          "t": [
            "Ich bin satt",
            "Ich bin satt danke"
          ]
        }
      ]
    },
    {
      "id": "pron-u06-l2",
      "kind": "pron",
      "title": "Long and short o, ö, e, u, ü",
      "goal": "Keep long and short vowels apart.",
      "tip": {
        "title": "Tense or relaxed",
        "body": "Long o in Ofen is a pure, rounded \"oh\" with no glide. Short o in offen is open, like British \"hot\". Long e (Beet) is a tense \"ay\" without the y-glide; short e (Bett) is like \"bed\"."
      },
      "phrases": [
        {
          "t": "Die Tür ist offen.",
          "n": "The door is open."
        },
        {
          "t": "Ich muss jetzt gehen.",
          "n": "I have to go now."
        },
        {
          "t": "Das Bett ist bequem.",
          "n": "The bed is comfortable."
        },
        {
          "t": "Der Ofen ist heiß.",
          "n": "The oven is hot."
        }
      ],
      "pairs": [
        {
          "sound": "long o / short o",
          "a": {
            "t": "Ofen",
            "n": "oven"
          },
          "b": {
            "t": "offen",
            "n": "open"
          }
        },
        {
          "sound": "long ö / short ö",
