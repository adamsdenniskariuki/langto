    {
      "id": "pron-u05-l2",
      "kind": "pron",
      "title": "z and pf",
      "goal": "Say z as \"ts\" and pf in one go.",
      "tip": {
        "title": "Two sounds glued together",
        "body": "German z is always \"ts\" as in \"cats\" — even at the start: Zeit = \"tsait\", Zoo = \"tso\". For pf, close your lips for p and release straight into f: Pfund. Don't drop the p."
      },
      "phrases": [
