    {
      "id": "pron-u05-l1",
      "kind": "pron",
      "title": "w and v",
      "goal": "Say w as \"v\" and v as \"f\".",
      "tip": {
        "title": "Teeth on lip",
        "body": "German w is English \"v\": touch your top teeth to your lower lip and buzz (Wasser = \"vasser\"). German v is usually \"f\" (Vater = \"fahter\"). In some foreign words v stays \"v\": Vase, Video."
      },
      "phrases": [
        {
          "t": "Wasser, bitte.",
          "n": "Water, please."
        },
        {
          "t": "Mein Vater wohnt in Wien.",
          "n": "My father lives in Vienna."
        },
        {
          "t": "Wie viel kostet das?",
          "n": "How much is that?"
        },
        {
          "t": "Die Vase ist schön.",
          "n": "The vase is beautiful."
        }
      ],
      "pairs": [
        {
          "sound": "w / f",
          "a": {
            "t": "Wein",
            "n": "wine"
          },
          "b": {
