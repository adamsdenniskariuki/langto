    {
      "id": "pron-u04-l2",
      "kind": "pron",
      "title": "The silent r",
      "goal": "Vocalise r after long vowels.",
      "tip": {
        "title": "r turns into \"a\"",
        "body": "After a long vowel, r becomes a short, open \"uh/a\" glide: Bier ≈ \"bee-a\", hier ≈ \"hee-a\", vier ≈ \"fee-a\". The ending -er does the same: Vater ≈ \"Fah-ta\". Don't pronounce a hard r here."
      },
      "phrases": [
        {
          "t": "Ein Bier, bitte.",
          "n": "A beer, please."
        },
        {
          "t": "Mein Vater ist hier.",
          "n": "My father is here."
        },
        {
          "t": "Wir sind zu viert.",
          "n": "There are four of us."
        },
        {
          "t": "Das ist sehr gut.",
          "n": "That's very good."
        }
      ],
      "pairs": [
