  "lessons": [
    {
      "id": "pron-u04-l1",
      "kind": "pron",
      "title": "The back r",
      "goal": "Make the German r at the back of the mouth.",
      "tip": {
        "title": "Gargle gently",
        "body": "The standard German r is made at the back: raise the back of your tongue towards the uvula, as if gargling very softly. Don't curl the tongue tip like an English r. A rolled tip r is also understood (South, Austria, Switzerland)."
      },
      "phrases": [
        {
          "t": "Drei Brote, bitte.",
          "n": "Three loaves, please."
        },
        {
          "t": "Ich reise gern.",
          "n": "I like travelling."
        },
        {
          "t": "Das ist richtig.",
          "n": "That's right."
        },
        {
          "t": "Die Rose ist rot.",
          "n": "The rose is red."
        }
      ],
